---
// Pega as informações do produto passadas como propriedades (Props)
// Substituímos "foto" por "fotos" (um array de URLs/caminhos de imagem)
const { titulo, descricao, preco, fotos = [] } = Astro.props;

// Garante que fotos seja sempre um array (caso passem foto única ou nada)
const listaFotos = Array.isArray(fotos) && fotos.length > 0 
  ? fotos 
  : [Astro.props.foto || "/placeholder.jpg"];
---

<div class="bg-white rounded-2xl p-4 border border-rose-200 shadow-sm hover:shadow-md transition">
  <!-- Container do Carrossel -->
  <div class="carousel-container relative bg-rose-100 h-48 rounded-xl mb-4 overflow-hidden group">
    
    <!-- Imagem Principal -->
    <img 
      data-carousel-img 
      src={listaFotos[0]} 
      alt={titulo} 
      class="w-full h-48 object-cover transition-opacity duration-300" 
    />

    <!-- Botões de Navegação (só aparecem se houver mais de 1 foto) -->
    {listaFotos.length > 1 && (
      <>
        <button 
          data-prev 
          class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full p-1.5 opacity-0 group-hover:opacity-100 transition-opacity"
          aria-label="Foto anterior"
        >
          &#10094;
        </button>
        <button 
          data-next 
          class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full p-1.5 opacity-0 group-hover:opacity-100 transition-opacity"
          aria-label="Próxima foto"
        >
          &#10095;
        </button>
        
        <!-- Indicador de quantidade de fotos -->
        <span 
          data-counter 
          class="absolute bottom-2 right-2 bg-black/50 text-white text-xs px-2 py-0.5 rounded-full"
        >
          1 / {listaFotos.length}
        </span>
      </>
    )}
  </div>

  <h3 class="font-bold text-lg text-rose-950">{titulo}</h3>
  <p class="text-rose-700 text-sm mb-4">
    {descricao}
  </p>
  <div class="flex items-center justify-between">
    <span class="text-xl font-bold text-rose-900">
      R$ {preco.toFixed(2).replace(".", ",")}
    </span>
    <button class="bg-orange-500 hover:bg-orange-600 text-white font-medium px-4 py-2 rounded-lg text-sm transition">
      Ver Detalhes
    </button>
  </div>
</div>

<!-- Lógica do Carrossel do Lado do Cliente -->
<script is:inline define:vars={{ listaFotos }}>
  // Seleciona todos os containers de carrossel da página
  document.querySelectorAll('.carousel-container').forEach((container) => {
    const img = container.querySelector('[data-carousel-img]');
    const btnPrev = container.querySelector('[data-prev]');
    const btnNext = container.querySelector('[data-next]');
    const counter = container.querySelector('[data-counter]');

    if (!btnPrev || !btnNext || listaFotos.length <= 1) return;

    let currentIndex = 0;

    const updateImage = (index) => {
      currentIndex = index;
      if (currentIndex < 0) currentIndex = listaFotos.length - 1;
      if (currentIndex >= listaFotos.length) currentIndex = 0;

      img.src = listaFotos[currentIndex];
      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${listaFotos.length}`;
      }
    };

    btnPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      updateImage(currentIndex - 1);
    });

    btnNext.addEventListener('click', (e) => {
      e.stopPropagation();
      updateImage(currentIndex + 1);
    });
  });
</script>