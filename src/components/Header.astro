---
// Header.astro
---

<!-- CABEÇALHO -->
<header class="bg-amber-600 text-white shadow-sm py-4 px-6">
  <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-4">
    <div class="flex items-center space-x-4">
      <img
        src={`${import.meta.env.BASE_URL}/images/Logo/Logo.png`}
        alt="Logo do site"
        class="h-12 w-auto"
        loading="lazy"
        decoding="async"
      />
      <div>
        <h1 class="text-xl sm:text-2xl font-bold tracking-wide">Manoá Betel Art's</h1>
        <p class="text-sm sm:text-base">Acessórios e utilidades em cartonagem</p>
      </div>
    </div>

    <details class="relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md hover:bg-amber-700 focus:outline-2 focus:outline-offset-2 focus:outline-white [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menu de navegação">
        <span class="sr-only">Abrir menu</span>
        <span class="flex w-5 flex-col gap-1" aria-hidden="true">
          <span class="h-0.5 w-full bg-white"></span>
          <span class="h-0.5 w-full bg-white"></span>
          <span class="h-0.5 w-full bg-white"></span>
        </span>
      </summary>
      <nav class="absolute right-0 top-12 z-10 min-w-48 rounded-md bg-white p-2 text-sm font-medium text-amber-950 shadow-lg">
        <a href={`${import.meta.env.BASE_URL}/`} class="block rounded px-3 py-2 hover:bg-amber-50">
          Início
        </a>
        <a href={`${import.meta.env.BASE_URL}/Cover`} class="block rounded px-3 py-2 hover:bg-amber-50">
          Capas
        </a>
        <a href={`${import.meta.env.BASE_URL}/Present`} class="block rounded px-3 py-2 hover:bg-amber-50">
          Presentes
        </a>
        <a href={`${import.meta.env.BASE_URL}/Accessories`} class="block rounded px-3 py-2 hover:bg-amber-50">
          Acessórios
        </a>
      </nav>
    </details>

    <nav class="hidden space-x-4 text-amber-50 text-sm font-medium md:block">
      <a href={`${import.meta.env.BASE_URL}/`} class="hover:underline">
        Início
      </a>
      <a href={`${import.meta.env.BASE_URL}/Cover`} class="hover:underline">
        Capas
      </a>
      <a href={`${import.meta.env.BASE_URL}/Present`} class="hover:underline">
        Presentes
      </a>
      <a
        href={`${import.meta.env.BASE_URL}/Accessories`}
        class="hover:underline">
        Acessórios
      </a>
    </nav>
  </div>
</header>
