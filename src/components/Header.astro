---
// Header.astro
---

<!-- CABEÇALHO -->
<header class="bg-amber-600 text-white shadow-sm py-4 px-6">
  <div class="max-w-6xl mx-auto flex justify-between items-center">
    <div class="flex items-center space-x-4">
      <img
        src={`${import.meta.env.BASE_URL}/images/Logo/Logo.png`}
        alt="Logo do site"
        class="h-12 w-auto"
        loading="lazy"
        decoding="async"
      />
      <div>
        <h1 class="text-2xl font-bold tracking-wide">Manoá Betel Art's</h1>
        <p>Acessórios e utilidades em cartonagem</p>
      </div>
    </div>
    <nav class="space-x-4 text-amber-50 text-sm font-medium">
      <a href={`${import.meta.env.BASE_URL}/`} class="hover:underline">
        Início
      </a>
      <a href={`${import.meta.env.BASE_URL}/Cover`} class="hover:underline">
        Capas
      </a>
      <a href={`${import.meta.env.BASE_URL}/Present`} class="hover:underline">
        Presentes
      </a>
      <a
        href={`${import.meta.env.BASE_URL}/Accessories`}
        class="hover:underline">
        Acessórios
      </a>
    </nav>
  </div>
</header>
