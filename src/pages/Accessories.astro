---
import Layout from "../layouts/layout.astro";
import CardProduct from "../components/CardProduct.astro";
// Importa o arquivo JSON contendo os dados dos produtos
import Accessories from "../data/Accessories.json";

import Title from "../components/Title.astro";
---

<Layout>
  <Title
    title="Carteiras e Acessórios"
    subtitle="Descubra nossas carteiras e acessórios artesanais, feitos com cuidado e atenção aos detalhes."
  />

  <!-- Grid Responsivo de Produtos -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2 gap-6">
    {
      Accessories.map((accessory) => (
        <CardProduct
          titulo={accessory.titulo}
          descricao={accessory.descricao}
          preco={accessory.preco}
          fotos={accessory.fotos}
        />
      ))
    }
  </div>
</Layout>
