---
import Layout from "../layouts/layout.astro";
import CardProduct from "../components/CardProduct.astro";

// Importa o arquivo JSON contendo os dados dos produtos
import Presents from "../data/Present.json";

import Title from "../components/Title.astro";
---

<Layout>
  <Title
    title="Presenteie com originalidade"
    subtitle="Encontre o presente perfeito para qualquer ocasião."
  />

  <!-- Grid Responsivo de Produtos -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-6">
    {
      Presents.map((Present) => (
        <CardProduct
          titulo={Present.titulo}
          descricao={Present.descricao}
          preco={Present.preco}
          fotos={Present.fotos}
        />
      ))
    }
  </div>
</Layout>
